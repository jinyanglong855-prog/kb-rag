# 知识库语料根目录（只读引用，不把笔记复制进本仓库）
KB_PATH=/Users/yljin/Documents/项目文件

# 索引产物目录（默认 index/，相对路径锚定仓库根；测试或多实例部署时指向别处）
# INDEX_DIR=index

# 服务身份（MCP 多角色接入时由宿主按实例设置；缺省 local；scopes.json 规则表定各角色读写范围）
# KB_CALLER=local

# LLM API（OpenAI 兼容接口即可：智谱 GLM / DeepSeek 等；检索阶段不需要）
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.3-flash

# 国内 HuggingFace 镜像（首次下载嵌入模型用）
HF_ENDPOINT=https://hf-mirror.com
